<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/crew_cream">

    <ScrollView
        android:id="@+id/scrollDetail"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Foto + botón atrás -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/detail_image_height">

                <ImageView
                    android:id="@+id/imgDetail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/cd_plan_image"
                    android:scaleType="centerCrop" />

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="@dimen/back_button_size"
                    android:layout_height="@dimen/back_button_size"
                    android:layout_gravity="top|start"
                    android:layout_margin="@dimen/space_m"
                    android:background="@drawable/bg_circle_white"
                    android:contentDescription="@string/cd_back"
                    android:src="@drawable/ic_arrow_back" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_m">

                <TextView
                    android:id="@+id/txtDetailCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_cost"
                    android:paddingStart="@dimen/space_s"
                    android:paddingTop="@dimen/space_xs"
                    android:paddingEnd="@dimen/space_s"
                    android:paddingBottom="@dimen/space_xs"
                    android:textColor="@color/crew_teal_dark"
                    android:textSize="@dimen/text_small"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtDetailTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:textColor="@color/crew_navy"
                    android:textSize="@dimen/text_detail_title"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtDetailHost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:textColor="@color/crew_gray"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:text="@string/label_about"
                    android:textColor="@color/crew_navy"
                    android:textSize="@dimen/text_card_title"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtDetailDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:lineSpacingExtra="@dimen/space_xs"
                    android:textColor="@color/crew_navy"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:text="@string/label_details"
                    android:textColor="@color/crew_navy"
                    android:textSize="@dimen/text_card_title"
                    android:textStyle="bold" />

                <!-- Las filas se agregan desde Java -->
                <LinearLayout
                    android:id="@+id/containerInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Barra inferior fija con el botón -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="@dimen/card_elevation"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_m"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtDetailStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_s"
            android:background="@drawable/bg_chip_pending"
            android:paddingStart="@dimen/space_s"
            android:paddingTop="@dimen/space_xs"
            android:paddingEnd="@dimen/space_s"
            android:paddingBottom="@dimen/space_xs"
            android:text="@string/status_pending"
            android:textColor="@color/crew_orange"
            android:textSize="@dimen/text_small"
            android:textStyle="bold"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnDetailRequest"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_weight="1"
            android:backgroundTint="@color/crew_teal"
            android:text="@string/btn_request_join"
            android:textAllCaps="true"
            android:textColor="@color/white"
            app:cornerRadius="@dimen/button_radius" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>