<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/crew_cream">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="@dimen/login_image_height"
                android:contentDescription="@string/cd_plan_image"
                android:scaleType="centerCrop"
                android:src="@drawable/plan_burleigh" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/crew_teal"
                    android:textSize="@dimen/text_logo"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/slogan"
                    android:textColor="@color/crew_gray"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:text="@string/login_title"
                    android:textColor="@color/crew_navy"
                    android:textSize="@dimen/text_heading"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/login_subtitle"
                    android:textColor="@color/crew_gray"
                    android:textSize="@dimen/text_body" />

                <EditText
                    android:id="@+id/edtEmail"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:layout_marginTop="@dimen/space_l"
                    android:autofillHints="emailAddress"
                    android:background="@drawable/bg_input"
                    android:hint="@string/hint_email"
                    android:inputType="textEmailAddress"
                    android:paddingStart="@dimen/space_m"
                    android:paddingEnd="@dimen/space_m"
                    android:textColor="@color/crew_navy"
                    android:textColorHint="@color/crew_gray"
                    android:textSize="@dimen/text_body" />

                <EditText
                    android:id="@+id/edtPassword"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:layout_marginTop="@dimen/space_s"
                    android:autofillHints="password"
                    android:background="@drawable/bg_input"
                    android:hint="@string/hint_password"
                    android:inputType="textPassword"
                    android:paddingStart="@dimen/space_m"
                    android:paddingEnd="@dimen/space_m"
                    android:textColor="@color/crew_navy"
                    android:textColorHint="@color/crew_gray"
                    android:textSize="@dimen/text_body" />

                <Button
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/space_l"
                    android:backgroundTint="@color/crew_teal"
                    android:text="@string/btn_login"
                    android:textAllCaps="true"
                    android:textColor="@color/white"
                    app:cornerRadius="@dimen/button_radius" />

                <TextView
                    android:id="@+id/txtGoRegister"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:gravity="center"
                    android:padding="@dimen/space_s"
                    android:text="@string/link_to_register"
                    android:textColor="@color/crew_teal_dark"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>