<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/crew_cream">

    <!-- HEADER -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/crew_teal"
        android:orientation="vertical"
        android:padding="@dimen/space_m"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="@dimen/text_logo"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtSlogan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/slogan"
            android:textColor="@color/crew_teal_light"
            android:textSize="@dimen/text_body" />
    </LinearLayout>

    <!-- CONTENIDO SCROLLEABLE -->
    <ScrollView
        android:id="@+id/scrollDiscover"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/containerPlans"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_m">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/discover_question"
                android:textColor="@color/crew_navy"
                android:textSize="@dimen/text_heading"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:layout_marginBottom="@dimen/space_m"
                android:text="@string/location_default"
                android:textColor="@color/crew_gray"
                android:textSize="@dimen/text_body" />

            <!-- TARJETA DE PLAN -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_m"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/card_radius"
                app:cardElevation="@dimen/card_elevation"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/imgPlan"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/card_image_height"
                        android:contentDescription="@string/cd_plan_image"
                        android:scaleType="centerCrop"
                        android:src="@drawable/plan_burleigh" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_m">

                        <TextView
                            android:id="@+id/txtPlanTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sample_plan_title"
                            android:textColor="@color/crew_navy"
                            android:textSize="@dimen/text_card_title"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtPlanPlaceTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:text="@string/sample_plan_place_time"
                            android:textColor="@color/crew_gray"
                            android:textSize="@dimen/text_body" />

                        <!-- Fila horizontal: cupo + precio -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/txtPlanPeople"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/sample_plan_people"
                                android:textColor="@color/crew_navy"
                                android:textSize="@dimen/text_body" />

                            <TextView
                                android:id="@+id/txtPlanStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/space_s"
                                android:background="@drawable/bg_chip_pending"
                                android:paddingStart="@dimen/space_s"
                                android:paddingTop="@dimen/space_xs"
                                android:paddingEnd="@dimen/space_s"
                                android:paddingBottom="@dimen/space_xs"
                                android:text="@string/status_pending"
                                android:textColor="@color/crew_orange"
                                android:textSize="@dimen/text_small"
                                android:textStyle="bold"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/txtPlanCost"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_chip_free"
                                android:paddingStart="@dimen/space_s"
                                android:paddingTop="@dimen/space_xs"
                                android:paddingEnd="@dimen/space_s"
                                android:paddingBottom="@dimen/space_xs"
                                android:text="@string/free"
                                android:textColor="@color/crew_green"
                                android:textSize="@dimen/text_small"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/txtPlanHost"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:text="@string/sample_plan_host"
                            android:textColor="@color/crew_gray"
                            android:textSize="@dimen/text_small" />

                        <Button
                            android:id="@+id/btnRequestJoin"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/button_height"
                            android:layout_marginTop="@dimen/space_m"
                            android:backgroundTint="@color/crew_teal"
                            android:text="@string/btn_request_join"
                            android:textAllCaps="true"
                            android:textColor="@color/white"
                            app:cornerRadius="@dimen/button_radius" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>